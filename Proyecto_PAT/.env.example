# Copia este archivo como .env y agrega tus propias credenciales.
# No compartas ni subas el archivo .env.

# OpenAI: opcional, para el agente y su evaluador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o

# Tavily: opcional, para búsqueda web de precios.
TAVILY_API_KEY=

# Mercado Libre: opcional, para consulta y actualización de productos.
# ML_REDIRECT_URI debe coincidir con la URL registrada en la aplicación.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=